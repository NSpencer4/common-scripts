{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder:30b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.8:27b": {
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "shell": {
      "*": "deny",
      "mkdir -p *": "allow",
      "git mv *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "ls": "allow",
      "ls *": "allow"
    },
    "skill": "deny",
    "execute": "deny",
    "subagent": "deny",
    "websearch": "deny",
    "question": "deny"
  }
}
